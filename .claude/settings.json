{
  "permissions": {
    "deny": [
      "Bash(git push *master*)",
      "Bash(git push *main*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git * --no-verify*)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "Bash(gh repo *)",
      "Bash(gh secret *)",
      "Bash(gh ruleset *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": ["/mnt/c", "/mnt/d"],
      "allowWrite": ["~/.cache/uv", "~/.local/share/uv"]
    },
    "credentials": {
      "files": [
        { "path": "~/.ssh", "mode": "deny" }
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
